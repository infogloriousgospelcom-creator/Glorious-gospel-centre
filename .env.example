# ─────────────────────────────────────────────────────────────────────────────
# Glorious Gospel Centre — environment variables
# Copy this file to `.env.local` and fill values. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, OG tags, email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — public (safe for browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only. NEVER expose to the browser. NEVER commit.
# Required for admin/server code paths only. May be omitted during local UI dev.
SUPABASE_SERVICE_ROLE_KEY=

# M-Pesa Daraja (server-only). NEVER expose to the browser.
M_PESA_ENVIRONMENT=sandbox
M_PESA_CONSUMER_KEY=
M_PESA_CONSUMER_SECRET=
M_PESA_SHORTCODE=
M_PESA_PASSKEY=
M_PESA_CALLBACK_URL=
